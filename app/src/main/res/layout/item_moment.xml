<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivMomentAvatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="12dp"
        android:background="#EEEEEE"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMomentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#576B95"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMomentContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#111111"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvMomentTranslateBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="查看翻译"
            android:textColor="#576B95"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMomentTranslatedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#111111"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- ⚡ 老板专属：挂真图的极其高贵的相框！！单张图/视频时用（包在 FrameLayout 里 overlay 播放按钮）-->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:id="@+id/layoutMomentSingleMedia">

            <ImageView
                android:id="@+id/ivMomentRealImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxHeight="200dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop" />

            <!-- 单视频的播放按钮 -->
            <ImageView
                android:id="@+id/ivMomentRealImagePlay"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FFFFFF"
                android:background="#80000000"
                android:padding="8dp"
                android:visibility="gone" />

            <!-- 单视频的时长 -->
            <TextView
                android:id="@+id/tvMomentRealImageDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="#80000000"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />

        </FrameLayout>

        <!-- ⚡ 多张图九宫格，2-9 张时用 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMomentImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:visibility="gone" />

        <!-- ⚡ AI专属：画面描述的小黑板 -->
        <TextView
            android:id="@+id/tvMomentImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#AAF0F0F0"
            android:padding="8dp"
            android:textColor="#666666"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMomentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#999999"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMomentLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="🤍 赞"
                android:textColor="#576B95"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnMomentComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬 评论"
                android:textColor="#576B95"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutInteraction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#AAF7F7F7"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvMomentLikes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#576B95"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvMomentComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#333333"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvMomentCommentsTransBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="查看评论翻译"
                android:textColor="#576B95"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>